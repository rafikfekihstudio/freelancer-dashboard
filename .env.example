# Required
AUTH_SECRET=generate-with-node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# For local development — leave empty to use local SQLite file
# Set these only when deploying / running migrations against Turso
TURSO_DB_URL=
TURSO_DB_AUTH_TOKEN=

# Whitelabel
SITE_NAME=Dashboard
SITE_DESCRIPTION=Freelance photo retouching dashboard

# Optional — Resend email (leave empty to show passwords in UI)
RESEND_API_KEY=
EMAIL_FROM=

# Optional — Cloudinary (leave empty to use local filesystem fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
